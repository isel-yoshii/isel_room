# Copy to .env and fill in values before starting the server.

# Required — app will not start without these (in production)
FLASK_SECRET_KEY=change-me-to-a-random-string
ADMIN_PIN=your-admin-pin
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional — defaults shown
DATABASE_URL=sqlite:///isel_room.db
DAY_RESET_HOUR=22
SLACK_CHANNEL=#a-lab-status

# Logging. INFO shows every face-match decision (who matched, at what distance,
# and the runner-up) and the auto-checkout job. Set WARNING to quieten it.
LOG_LEVEL=INFO

# Face matching. Lower = stricter. Tune these at the kiosk, not in code:
# camera, lens and lighting differ between rooms.
#   LOW_CONFIDENCE_THRESHOLD  above this distance the kiosk asks you to retry
#   FACE_AUTH_THRESHOLD       above this distance it is not a match at all
#   FACE_MATCH_MARGIN         how much closer the winner must be than the
#                             runner-up PERSON. Guards against always reporting
#                             whoever enrolled the most frames. 0 disables.
#   FACE_DETECT_CONFIDENCE    minimum RetinaFace confidence before an embedding
#                             is trusted. Do not lower: with enforce_detection
#                             off, DeepFace returns a vector for any image.
LOW_CONFIDENCE_THRESHOLD=0.40
FACE_AUTH_THRESHOLD=0.55
FACE_MATCH_MARGIN=0.10
FACE_DETECT_CONFIDENCE=0.90

# Set to 0 on every gunicorn worker except one, so the nightly auto-checkout is
# scheduled exactly once. Set to 1 to force it on under `flask run --no-reload`.
# ENABLE_SCHEDULER=1

# Wi-Fi presence: the app scans the lab network itself and checks members in
# and out by their registered phones. Needs arp-scan set up once on the host:
#   sudo scripts/setup_arp_scan.sh
#   ENABLE_PRESENCE_SCAN    1 turns scanning on. Off by default.
#   PRESENCE_GRACE_MINUTES  how long a person's phone must go unseen before they
#                           are checked out. Sleeping phones miss scans; do not
#                           go much below 15.
#   PRESENCE_INTERFACE      network interface to scan, e.g. wlp3s0. Empty lets
#                           arp-scan pick.
#   PRESENCE_SCAN_INTERVAL  seconds between scans
ENABLE_PRESENCE_SCAN=0
PRESENCE_GRACE_MINUTES=30
# PRESENCE_INTERFACE=
# PRESENCE_SCAN_INTERVAL=60
